<%@ page pageEncoding="UTF-8" %>
<%@ include file="header.jspf" %>

<%String type=request.getAttribute("type").toString();%><section class="section"><div class="section-heading"><div><span class="eyebrow">INFORMATION WITH PERSPECTIVE</span><h1>The bigger <em>picture.</em></h1></div><div class="report-actions"><a class="button small ghost export-link" data-format="pdf" href="#">PDF &#8595;</a><a class="button small ghost export-link" data-format="xlsx" href="#">Excel &#8595;</a><button class="button small" data-print>Print</button></div></div><form class="report-filters panel" method="get" action="<%=ctx%>/reports"><label>Report<select name="type"><%for(var report:ReportService.NAMES.entrySet()){%><option value="<%=report.getKey()%>" <%=type.equals(report.getKey())?"selected":""%>><%=report.getValue()%></option><%}%></select></label><label>From<input type="date" name="from" value="<%=ViewUtils.e(request.getParameter("from"))%>"></label><label>To<input type="date" name="to" value="<%=ViewUtils.e(request.getParameter("to"))%>"></label><label>Branch<select name="branch"><option value="">All permitted branches</option><%for(var br:(List<Map<String,Object>>)request.getAttribute("branches")){%><option value="<%=br.get("id")%>" <%=br.get("id").toString().equals(request.getParameter("branch"))?"selected":""%>><%=ViewUtils.e(br.get("name"))%></option><%}%></select></label><label>Category<select name="category"><option value="">All categories</option><%for(var cat:(List<Map<String,Object>>)request.getAttribute("categories")){%><option value="<%=cat.get("id")%>" <%=cat.get("id").toString().equals(request.getParameter("category"))?"selected":""%>><%=ViewUtils.e(cat.get("name"))%></option><%}%></select></label><button class="button">Generate</button></form><p class="micro">Date filters apply to transaction reports. Category and branch filters apply where the report has those relationships. Collection summaries are library-wide.</p><section class="panel"><div class="section-heading"><h3><%=ReportService.NAMES.get(type)%></h3><input class="table-search" type="search" placeholder="Search results…" aria-label="Search report"></div><%var rows=(List<Map<String,Object>>)request.getAttribute("rows");%><div class="table-wrap"><table><thead><tr><%if(!rows.isEmpty())for(String key:rows.get(0).keySet()){%><th><%=ViewUtils.e(key.replace('_',' '))%></th><%}%><%if(Boolean.TRUE.equals(request.getAttribute("tableActions"))){%><th>Actions</th><%}%></tr></thead><tbody><%for(var row:rows){%><tr><%for(var cell:row.entrySet()){%><td><%if(cell.getKey().equals("status")||cell.getKey().equals("format")){%><span class="pill"><%=ViewUtils.e(cell.getValue())%></span><%}else if(cell.getValue() instanceof Timestamp){%><%=ViewUtils.date(cell.getValue())%><%}else{%><%=ViewUtils.e(cell.getValue())%><%}%></td><%}%></tr><%}%></tbody></table><%if(rows.isEmpty()){%><div class="empty"><h3>Nothing here just yet.</h3><p>Records will appear here as the library is used.</p></div><%}%></div></section></section>

<%@ include file="footer.jspf" %>
