<%@ page pageEncoding="UTF-8" %>
<%@ include file="header.jspf" %>

<section class="section"><div class="section-heading"><div><span class="eyebrow">YOUR TRANSACTIONS</span><h1>Every chapter, <em>accounted for.</em></h1></div></div><div class="panel"><%var rows=(List<Map<String,Object>>)request.getAttribute("rows");request.setAttribute("tableActions",true);%><div class="table-wrap"><table><thead><tr><%if(!rows.isEmpty())for(String key:rows.get(0).keySet()){%><th><%=ViewUtils.e(key.replace('_',' '))%></th><%}%><%if(Boolean.TRUE.equals(request.getAttribute("tableActions"))){%><th>Actions</th><%}%></tr></thead><tbody><%for(var row:rows){%><tr><%for(var cell:row.entrySet()){%><td><%if(cell.getKey().equals("status")||cell.getKey().equals("format")){%><span class="pill"><%=ViewUtils.e(cell.getValue())%></span><%}else if(cell.getValue() instanceof Timestamp){%><%=ViewUtils.date(cell.getValue())%><%}else{%><%=ViewUtils.e(cell.getValue())%><%}%></td><%}%><td><%if(row.get("status").equals("SUCCESSFUL")){%><a class="table-link" href="<%=ctx%>/receipt?id=<%=row.get("id")%>">Receipt &#8599;</a><%}else if(row.get("status").equals("PENDING")){%><a class="table-link" href="<%=ctx%>/checkout?id=<%=row.get("id")%>">Continue &#8594;</a><%}else if(Set.of("FAILED","CANCELLED").contains(row.get("status"))){%><form method="post" action="<%=ctx%>/action"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="retry"><input type="hidden" name="id" value="<%=row.get("id")%>"><button class="text-button">Retry</button></form><%}%></td></tr><%}%></tbody></table><%if(rows.isEmpty()){%><div class="empty"><h3>Nothing here just yet.</h3><p>Records will appear here as the library is used.</p></div><%}%></div></div></section>

<%@ include file="footer.jspf" %>
