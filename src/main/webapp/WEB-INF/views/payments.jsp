<%@ page pageEncoding="UTF-8" %>
<%@ include file="header.jspf" %>

<section class="section"><div class="section-heading"><div><span class="eyebrow">YOUR TRANSACTIONS</span><h1>Every chapter, <em>accounted for.</em></h1></div></div><div class="panel"><%var rows=(List<Map<String,Object>>)request.getAttribute("rows");request.setAttribute("tableActions",true);%><div class="table-wrap"><table><thead><tr><%if(!rows.isEmpty())for(String key:rows.get(0).keySet())if(ModuleAccess.showColumn(key)){%><th><%=Web.e(key.replace('_',' '))%></th><%}%><%if(Boolean.TRUE.equals(request.getAttribute("tableActions"))){%><th>Actions</th><%}%></tr></thead><tbody><%for(var row:rows){%><tr><%for(var cell:row.entrySet())if(ModuleAccess.showColumn(cell.getKey())){%><td><%if(cell.getKey().equals("status")||cell.getKey().equals("format")){%><span class="pill"><%=Web.e(cell.getValue())%></span><%}else if(cell.getKey().equals("active")){%><span class="pill"><%=((Number)cell.getValue()).intValue()==1?"Active":"Inactive"%></span><%}else if(cell.getValue() instanceof Timestamp){%><%=Web.date(cell.getValue())%><%}else{%><%=Web.e(cell.getValue())%><%}%></td><%}%><td><%if(row.get("status").equals("SUCCESSFUL")){%><a class="table-link" href="<%=ctx%>/receipt?id=<%=row.get("id")%>">Receipt &#8599;</a><%}%></td></tr><%}%></tbody></table><%if(rows.isEmpty()){%><div class="empty"><h3>Nothing here just yet.</h3><p>Records will appear here as the library is used.</p></div><%}%></div></div></section>

<%@ include file="footer.jspf" %>
