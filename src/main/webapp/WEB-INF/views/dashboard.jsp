<%@ page pageEncoding="UTF-8" %>
<%@ include file="header.jspf" %>

<section class="section workspace"><div class="workspace-title"><div><span class="eyebrow">THE LIBRARY, AT A GLANCE</span><h1>A little order.<br><em>A world of possibility.</em></h1></div><div class="date-card"><span>LUMINA WORKSPACE</span><strong><%=ViewUtils.e(user.get("name"))%></strong><small><%=ViewUtils.e(user.get("role").toString().replace('_',' '))%></small></div></div><%var stats=(List<Object>)request.getAttribute("stats");String[] labels={"Titles in the collection","Physical books on loan","Active digital readings","Confirmed receipts"};%><div class="stats-grid"><%for(int i=0;i<4;i++){%><article class="stat-card"><span class="stat-number">0<%=i+1%></span><strong><%=i==3?ViewUtils.money(stats.get(i)):stats.get(i)%></strong><p><%=labels[i]%></p></article><%}%></div><%var extra=(List<Object>)request.getAttribute("extraStats");String[] extraLabels={"Active members","Physical copies","Overdue copies","Open reservations"};%><div class="stats-grid"><%for(int i=0;i<4;i++){%><article class="stat-card"><strong><%=extra.get(i)%></strong><p><%=extraLabels[i]%></p></article><%}%></div><div class="dashboard-grid"><section class="panel"><div class="section-heading"><div><span class="eyebrow">COLLECTION PULSE</span><h3>What readers reach for.</h3></div><a href="<%=ctx%>/reports?type=popular">View report &#8599;</a></div><%for(var row:(List<Map<String,Object>>)request.getAttribute("popular")){%><div class="chart-row"><span><%=ViewUtils.e(row.get("title"))%></span><div class="bar-track"><div style="width:<%=Math.min(100,10+JdbcRepository.id(row,"n")*8)%>%"></div></div><b><%=row.get("n")%></b></div><%}%></section><section class="panel dark-panel"><span class="eyebrow light-gold">THE SERVICE DESK</span><h3>Keep the library<br><em>moving beautifully.</em></h3><%if(staff){%><a class="button gold" href="<%=ctx%>/circulation">Issue or return a book &#8594;</a><a class="underlined" href="<%=ctx%>/book-edit">Add to the collection &#8599;</a><%}else{%><a class="button gold" href="<%=ctx%>/reports">Explore library reports &#8594;</a><%}%></section></div><section class="panel"><div class="section-heading"><h3>Your recent updates</h3><a href="<%=ctx%>/notifications">All notifications &#8594;</a></div><%for(var n:(List<Map<String,Object>>)request.getAttribute("activity")){%><a class="activity-row" href="<%=ctx%><%=ViewUtils.e(n.get("link"))%>"><span class="status-dot"></span><span><strong><%=ViewUtils.e(n.get("title"))%></strong><small><%=ViewUtils.e(n.get("message"))%></small></span><time><%=ViewUtils.date(n.get("created_at"))%></time></a><%}%></section><p class="micro">Digital totals and receipts are library-wide. Branch managers see their assigned branch's physical loans. Demo receipts are included when demonstration checkout is enabled.</p></section>

<%@ include file="footer.jspf" %>
