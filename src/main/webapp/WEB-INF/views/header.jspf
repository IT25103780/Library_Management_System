<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" import="java.util.*,java.sql.*,lk.lumina.config.*,lk.lumina.service.*,lk.lumina.security.*,lk.lumina.util.*,lk.lumina.repository.*" %>
<% String ctx=request.getContextPath(), current=Objects.toString(request.getAttribute("path"),""); Map<String,Object> user=(Map<String,Object>)request.getAttribute("user"); String csrf=Objects.toString(session.getAttribute("csrf"),""); boolean staff=AccessControl.staff(user), manager=AccessControl.manager(user); %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#2B1B17"><meta name="description" content="Lumina Library. A quieter place to discover your next great read."><title>Lumina Library · A world within reach</title><link rel="icon" href="<%=ctx%>/assets/mark.svg" type="image/svg+xml"><link rel="stylesheet" href="<%=ctx%>/assets/style.css"><link rel="stylesheet" href="<%=ctx%>/assets/refined.css"><script src="<%=ctx%>/assets/app.js" defer></script><script src="<%=ctx%>/assets/refined.js" defer></script><link rel="stylesheet" href="<%=ctx%>/assets/workspace-polish.css"><script src="<%=ctx%>/assets/workspace-polish.js?v=card-fix-2" defer></script><script src="<%=ctx%>/assets/card-input.js?v=2" defer></script></head>
<body class="<%=user!=null&&!Set.of("/","/home").contains(current)?"refined-workspace":""%>" data-context="<%=ctx%>" data-signed-in="<%=user!=null%>"><a class="skip" href="#main">Skip to content</a>
<header class="topbar"><a class="brand" href="<%=ctx%>/home"><img src="<%=ctx%>/assets/mark.svg" alt="" width="38" height="38"><span>LUMINA<small>THE LIBRARY</small></span></a><nav class="public-nav" aria-label="Main navigation"><a class="<%=current.equals("/home")||current.equals("/")?"active":""%>" href="<%=ctx%>/home">Discover</a><a class="<%=current.equals("/catalog")?"active":""%>" href="<%=ctx%>/catalog">The collection</a><a href="<%=ctx%>/catalog?format=DIGITAL">Digital library</a><%if(user!=null){%><a href="<%=ctx%>/my-books">My Books</a><%}%></nav><div class="nav-actions"><%if(user==null){%><a class="login-link" href="<%=ctx%>/login">Sign in <span>&#8599;</span></a><a class="button small gold" href="<%=ctx%>/signup">Join the library</a><%}else{%><a class="bell" href="<%=ctx%>/notifications" aria-label="Notifications"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4"/></svg><span id="notification-count" hidden>0</span></a><a class="avatar" href="<%=ctx%>/profile" aria-label="Your account"><%=ViewUtils.e(user.get("name").toString().substring(0,1))%></a><%if(manager){%><a class="button small gold" href="<%=ctx%>/dashboard">Workspace</a><%}%><form method="post" action="<%=ctx%>/logout" class="inline"><input type="hidden" name="csrf" value="<%=csrf%>"><button class="text-button light" type="submit">Sign out</button></form><%}%><button class="menu-toggle" aria-label="Toggle navigation" aria-expanded="false">&#9776;</button></div></header>
<%if(user!=null&&!Set.of("/","/home","/catalog","/book","/login","/signup","/reader").contains(current)){%><nav class="workspace-nav" aria-label="Workspace navigation"><%if(manager){%><a href="<%=ctx%>/dashboard">Overview</a><%}if(staff){%><a href="<%=ctx%>/manage?entity=books">Books</a><a href="<%=ctx%>/circulation">Circulation</a><a href="<%=ctx%>/manage?entity=categories">Directories</a><a href="<%=ctx%>/manage?entity=purchases">Acquisitions</a><%}%><a href="<%=ctx%>/my-books">My Books</a><a href="<%=ctx%>/reservations">Reservations</a><a href="<%=ctx%>/fines">Fines</a><a href="<%=ctx%>/payments">Payments</a><%if(manager){%><a href="<%=ctx%>/reports">Reports</a><%}if(user.get("role").equals("ADMIN")){%><a href="<%=ctx%>/manage?entity=users">Accounts</a><a href="<%=ctx%>/manage?entity=branches">Branches</a><a href="<%=ctx%>/payment-admin">Payment desk</a><a href="<%=ctx%>/settings">Settings</a><a href="<%=ctx%>/audit">Activity log</a><%}%></nav><%}%>
<%if(session.getAttribute("flash")!=null){%><div class="flash" role="status"><span class="status-dot"></span><%=ViewUtils.e(session.getAttribute("flash"))%><button aria-label="Dismiss message" data-dismiss>&#215;</button></div><%session.removeAttribute("flash");}%>
<main id="main">
