<%@ page pageEncoding="UTF-8" %>
<%@ include file="header.jspf" %>

<section class="section"><div class="section-heading"><div><span class="eyebrow">LIBRARY BALANCES</span><h1>A clean slate.</h1><p>Assess overdue fines at any time. Unadjusted fines are recalculated on return; each payment reduces the balance.</p></div></div><%if(staff){%><form method="post" action="<%=ctx%>/action"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="assess-fines"><input type="hidden" name="id" value="<%=""%>"><button class="button">Assess overdue loans</button></form><%}%><div class="panel"><%var rows=(List<Map<String,Object>>)request.getAttribute("rows");request.setAttribute("tableActions",true);%><div class="table-wrap"><table><thead><tr><%if(!rows.isEmpty())for(String key:rows.get(0).keySet())if(ModuleAccess.showColumn(key)){%><th><%=Web.e(key.replace('_',' '))%></th><%}%><%if(Boolean.TRUE.equals(request.getAttribute("tableActions"))){%><th>Actions</th><%}%></tr></thead><tbody><%for(var row:rows){%><tr><%for(var cell:row.entrySet())if(ModuleAccess.showColumn(cell.getKey())){%><td><%if(cell.getKey().equals("status")||cell.getKey().equals("format")){%><span class="pill"><%=Web.e(cell.getValue())%></span><%}else if(cell.getKey().equals("active")){%><span class="pill"><%=((Number)cell.getValue()).intValue()==1?"Active":"Inactive"%></span><%}else if(cell.getValue() instanceof Timestamp){%><%=Web.date(cell.getValue())%><%}else{%><%=Web.e(cell.getValue())%><%}%></td><%}%><td><a class="table-link" href="<%=ctx%>/fine?id=<%=row.get("id")%>">Details &amp; payment history</a><%if(Set.of("OUTSTANDING","PARTIALLY_PAID").contains(row.get("status"))){if(DB.id(row,"user_id")==DB.id(user,"id")){%><span class="micro">Pay at the library desk. Staff will record your payment.</span><%}if(staff){%><form method="post" action="<%=ctx%>/action" data-confirm="Confirm this cash payment has actually been received?"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="offline-fine"><input type="hidden" name="id" value="<%=row.get("id")%>"><label>Amount received<input name="amount" type="number" step="0.01" min="0.01" max="<%=row.get("balance")%>" value="<%=row.get("balance")%>" required></label><label>Method<select name="method"><option>CASH</option><option>BANK_TRANSFER</option><option>OTHER_OFFLINE</option></select></label><label>Receipt / reference<input name="reference" maxlength="120"></label><button class="button small">Record payment</button></form><%}}%><%if(staff&&Set.of("OUTSTANDING","PARTIALLY_PAID").contains(row.get("status"))){%><details class="row-editor"><summary>Adjust fine</summary><form method="post" action="<%=ctx%>/action"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="adjust-fine"><input type="hidden" name="id" value="<%=row.get("id")%>"><label>Revised amount<input name="amount" type="number" step="0.01" min="0" value="<%=row.get("amount")%>" required></label><label>Reason<input name="reason" maxlength="500" required></label><button class="button small">Save adjustment</button></form></details><%}%><%if(staff&&!Set.of("VOID","WAIVED").contains(row.get("status"))){%><details class="row-editor"><summary>Void incorrect fine</summary><form method="post" action="<%=ctx%>/action"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="void-fine"><input type="hidden" name="id" value="<%=row.get("id")%>"><label>Reason<input name="reason" required maxlength="500"></label><button class="button small">Void fine</button></form></details><%}%></td></tr><%}%></tbody></table><%if(rows.isEmpty()){%><div class="empty"><h3>Nothing here just yet.</h3><p>Records will appear here as the library is used.</p></div><%}%></div></div></section>

<%@ include file="footer.jspf" %>
