<%@ page pageEncoding="UTF-8" %>
<%@ include file="header.jspf" %>

<section class="section"><div class="section-heading"><div><span class="eyebrow">GOOD THINGS ARE WORTH THE WAIT</span><h1>A place in <em>the queue.</em></h1></div><a class="button" href="<%=ctx%>/catalog?format=PHYSICAL">Find a book to reserve</a></div><%if(staff){%><details class="panel edit-panel"><summary>Reserve for a member</summary><form method="post" action="<%=ctx%>/action"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="reserve-member"><div class="form-grid"><label>Member<select name="user_id"><%for(var m:JdbcRepository.list("SELECT id,name FROM users WHERE active=1 ORDER BY name")){%><option value="<%=m.get("id")%>"><%=ViewUtils.e(m.get("name"))%></option><%}%></select></label><label>Book<select name="book_id"><%for(var b:JdbcRepository.list("SELECT id,title FROM books WHERE active=1 AND format<>'DIGITAL' ORDER BY title")){%><option value="<%=b.get("id")%>"><%=ViewUtils.e(b.get("title"))%></option><%}%></select></label><label>Branch<select name="branch_id"><%for(var br:(List<Map<String,Object>>)request.getAttribute("branches")){%><option value="<%=br.get("id")%>"><%=ViewUtils.e(br.get("name"))%></option><%}%></select></label></div><button class="button">Reserve for member</button></form></details><%}%><div class="reservation-grid"><%var rows=(List<Map<String,Object>>)request.getAttribute("rows");for(var row:rows){%><article class="panel reservation-card"><span class="queue-number">#<%=row.get("id")%></span><span class="pill"><%=ViewUtils.e(row.get("status"))%></span><h3><%=ViewUtils.e(row.get("title"))%></h3><p><%=ViewUtils.e(row.get("branch"))%></p><%if(staff){%><p>Reader: <%=ViewUtils.e(row.get("name"))%></p><%}%><small>Reserved <%=ViewUtils.date(row.get("created_at"))%></small><%if(row.get("ready_until")!=null){%><p class="collection-note">Collect before <strong><%=ViewUtils.date(row.get("ready_until"))%></strong></p><%}if(Set.of("WAITING","READY").contains(row.get("status"))){%><form method="post" action="<%=ctx%>/action" data-confirm="Cancel this reservation?"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="cancel-reservation"><input type="hidden" name="id" value="<%=row.get("id")%>"><button class="text-button">Cancel reservation</button></form><details class="row-editor"><summary>Change collection branch</summary><form method="post" action="<%=ctx%>/action"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="reservation-edit"><input type="hidden" name="id" value="<%=row.get("id")%>"><p>Changing branch places this request at the end of the new branch queue.</p><label>Branch<select name="branch_id"><%for(var br:(List<Map<String,Object>>)request.getAttribute("branches")){%><option value="<%=br.get("id")%>" <%=Objects.equals(br.get("id"),row.get("branch_id"))?"selected":""%>><%=ViewUtils.e(br.get("name"))%></option><%}%></select></label><button class="button small">Update reservation</button></form></details><%}%></article><%}if(rows.isEmpty()){%><div class="empty wide"><h2>No reservations yet.</h2><p>Reserve a physical book from its details page. We will notify you when it is ready.</p></div><%}%></div></section>

<%@ include file="footer.jspf" %>
