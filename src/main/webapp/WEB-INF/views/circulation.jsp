<%@ page pageEncoding="UTF-8" %>
<%@ include file="header.jspf" %>

<section class="section"><div class="section-heading"><div><span class="eyebrow">THE SERVICE DESK</span><h1>Stories in <em>circulation.</em></h1></div><a class="link-arrow" href="<%=ctx%>/manage?entity=copies">Manage physical copies &#8599;</a></div><div class="issue-panel"><div><span class="step-badge">01</span><h3>Send a story home.</h3><p>Select a reader and an available copy. Due dates and eligibility are checked automatically.</p></div><form method="post" action="<%=ctx%>/action" class="issue-form"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="issue"><label>Reader<select name="user_id" required><option value="">Select reader</option><%for(var reader:(List<Map<String,Object>>)request.getAttribute("readers")){%><option value="<%=reader.get("id")%>">#<%=reader.get("id")%> · <%=ViewUtils.e(reader.get("name"))%> · <%=ViewUtils.e(reader.get("email"))%></option><%}%></select></label><label>Physical copy<select name="copy_id" required><option value="">Select copy</option><%for(var copy:(List<Map<String,Object>>)request.getAttribute("copies")){%><option value="<%=copy.get("id")%>">#<%=copy.get("id")%> · <%=ViewUtils.e(copy.get("title"))%> · <%=ViewUtils.e(copy.get("branch"))%> · <%=ViewUtils.e(copy.get("status"))%></option><%}%></select></label><button class="button">Issue book &#8594;</button></form></div><section class="panel"><div class="section-heading"><h3>Loans &amp; returns</h3><input class="table-search" type="search" placeholder="Search these records…" aria-label="Search loans"></div><%var rows=(List<Map<String,Object>>)request.getAttribute("rows");request.setAttribute("tableActions",true);%><div class="table-wrap"><table><thead><tr><%if(!rows.isEmpty())for(String key:rows.get(0).keySet()){%><th><%=ViewUtils.e(key.replace('_',' '))%></th><%}%><%if(Boolean.TRUE.equals(request.getAttribute("tableActions"))){%><th>Actions</th><%}%></tr></thead><tbody><%for(var row:rows){%><tr><%for(var cell:row.entrySet()){%><td><%if(cell.getKey().equals("status")||cell.getKey().equals("format")){%><span class="pill"><%=ViewUtils.e(cell.getValue())%></span><%}else if(cell.getValue() instanceof Timestamp){%><%=ViewUtils.date(cell.getValue())%><%}else{%><%=ViewUtils.e(cell.getValue())%><%}%></td><%}%><td><%if(Set.of("ACTIVE","OVERDUE").contains(row.get("status"))){%><form method="post" action="<%=ctx%>/action" data-confirm="Record this book as returned?"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="return"><input type="hidden" name="id" value="<%=row.get("id")%>"><button class="button small">Return book</button></form><details class="row-editor"><summary>Change due date</summary><form method="post" action="<%=ctx%>/action"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="due-date"><input type="hidden" name="id" value="<%=row.get("id")%>"><label>New due date (Sri Lanka time)<input type="datetime-local" name="due_at" required></label><label>Reason<input name="reason" maxlength="500" required></label><button class="button small">Save due date</button></form></details><%}%><%if(!row.get("status").equals("VOID")){%><details class="row-editor"><summary>Void mistaken transaction</summary><form method="post" action="<%=ctx%>/action"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="void-loan"><input type="hidden" name="id" value="<%=row.get("id")%>"><label>Correction reason<input name="reason" maxlength="500" required></label><button class="button small">Void and retain history</button></form></details><%}%></td></tr><%}%></tbody></table><%if(rows.isEmpty()){%><div class="empty"><h3>Nothing here just yet.</h3><p>Records will appear here as the library is used.</p></div><%}%></div></section></section>

<%@ include file="footer.jspf" %>
