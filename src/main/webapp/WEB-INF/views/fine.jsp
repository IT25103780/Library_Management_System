<%@ page pageEncoding="UTF-8" %>
<%@ include file="header.jspf" %>
<%var f=(Map<String,Object>)request.getAttribute("fine");%><section class="section"><h1>Fine #<%=f.get("id")%></h1><p><%=Web.e(f.get("name"))%> · <%=Web.e(f.get("title"))%></p><p><strong><%=Web.money(f.get("amount"))%></strong> · <%=Web.e(f.get("status"))%></p><p><%=Web.e(f.get("reason"))%></p><h2>Payment history</h2><div class="table-wrap"><table><thead><tr><th>Payment</th><th>Amount</th><th>Method</th><th>Reference</th><th>Status</th><th>Actions</th></tr></thead><tbody><%for(var row:(List<Map<String,Object>>)request.getAttribute("rows")){%><tr><td>#<%=row.get("id")%><br><%=Web.date(row.get("created_at"))%></td><td><%=Web.money(row.get("amount"))%></td><td><%=Web.e(row.get("method"))%></td><td><%=Web.e(row.get("provider_ref"))%></td><td><%=Web.e(row.get("status"))%></td><td><%if(row.get("status").equals("SUCCESSFUL")){%><a class="table-link" href="<%=ctx%>/receipt?id=<%=row.get("id")%>">Receipt</a><%if(staff&&row.get("provider").equals("OFFLINE")){%><details class="row-editor"><summary>Correct record</summary><form method="post" action="<%=ctx%>/action"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="id" value="<%=row.get("id")%>"><input type="hidden" name="action" value="payment-correct"><label>Method<select name="method"><option>CASH</option><option>BANK_TRANSFER</option><option>OTHER_OFFLINE</option></select></label><label>Reference<input name="reference" maxlength="120" value="<%=Web.e(row.get("provider_ref"))%>"></label><label>Correction reason<input name="reason" maxlength="500" required></label><button class="button small">Save correction</button></form><form method="post" action="<%=ctx%>/action" data-confirm="Reverse this incorrect payment record and restore the fine balance? This does not transfer money."><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="id" value="<%=row.get("id")%>"><input type="hidden" name="action" value="payment-void"><label>Reversal reason<input name="reason" required maxlength="500"></label><button class="text-button">Reverse incorrect record</button></form></details><%}}%></td></tr><%}%></tbody></table></div><p>To correct an amount, reverse the incorrect record and enter the correct payment. Both entries remain traceable.</p><a class="button" href="<%=ctx%>/fines">Back to fines</a></section>
<%@ include file="footer.jspf" %>