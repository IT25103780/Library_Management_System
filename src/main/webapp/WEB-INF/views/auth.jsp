<%@ page pageEncoding="UTF-8" %>
<%@ include file="header.jspf" %>

<section class="auth-scene"><div class="auth-message"><span class="eyebrow light-gold">WELCOME TO YOUR NEXT CHAPTER</span><h1>A good book.<br>A quiet moment.<br><em>Your own world.</em></h1><p>Your next discovery is waiting on the shelf.</p></div><div class="auth-card"><span class="eyebrow">LUMINA LIBRARY</span><%if(current.equals("/login")){%><h2>Welcome back.</h2><p class="muted">Your reading room is right where you left it.</p><form method="post" action="<%=ctx%>/login"><input type="hidden" name="csrf" value="<%=csrf%>"><label>Email or username<input name="username" required autocomplete="username" maxlength="180" placeholder="Enter your email or username"></label><label>Password<div class="password-wrap"><input type="password" name="password" required autocomplete="current-password" maxlength="128" placeholder="Your password"><button type="button" data-password>Show</button></div></label><a class="form-link" href="<%=ctx%>/forgot">Forgot password?</a><button class="button full">Sign in &#8594;</button></form><p class="auth-switch">New to Lumina? <a href="<%=ctx%>/signup">Create an account</a></p><%}else if(current.equals("/signup")){%><h2>Begin your story.</h2><p class="muted">A whole library of possibilities awaits.</p><form method="post" action="<%=ctx%>/signup" class="compact-form"><input type="hidden" name="csrf" value="<%=csrf%>"><label>Full name<input name="name" required maxlength="180" autocomplete="name"></label><div class="form-grid"><label>Email<input name="email" type="email" required maxlength="180" autocomplete="email"></label><label>Username<input name="username" required minlength="3" maxlength="40" autocomplete="username" pattern="[a-zA-Z0-9_.-]{3,40}"></label><label>Phone<input name="phone" required maxlength="40" autocomplete="tel"></label><label>Address<input name="address" required maxlength="500" autocomplete="street-address"></label><label>Password<input data-strong-password type="password" name="password" minlength="10" maxlength="128" autocomplete="new-password" required></label><label>Confirm password<input type="password" name="confirm_password" minlength="10" maxlength="128" autocomplete="new-password" required></label></div><small>Use at least 10 characters for your password.</small><button class="button full">Create account &#8594;</button></form><p class="auth-switch">Already have an account? <a href="<%=ctx%>/login">Sign in</a></p><%}else if(current.equals("/forgot")){%><h2>A fresh start.</h2><p class="muted">Enter your email to request a password reset.</p><form method="post" action="<%=ctx%>/forgot"><input type="hidden" name="csrf" value="<%=csrf%>"><label>Email address<input type="email" name="email" required autocomplete="email"></label><button class="button full">Send reset link</button></form><%if(session.getAttribute("devReset")!=null){%><div class="notice">Local demonstration only: email is not configured.<br><a href="<%=ViewUtils.e(session.getAttribute("devReset"))%>">Open test reset link &#8594;</a></div><%session.removeAttribute("devReset");}%><a class="form-link" href="<%=ctx%>/login">Back to sign in</a><%}else{%><h2>New password.</h2><form method="post" action="<%=ctx%>/reset"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="token" value="<%=ViewUtils.e(request.getParameter("token"))%>"><label>New password<input data-strong-password type="password" name="password" minlength="10" maxlength="128" required autocomplete="new-password"></label><label>Confirm password<input type="password" name="confirm_password" minlength="10" maxlength="128" required autocomplete="new-password"></label><button class="button full">Reset password</button></form><%}%></div></section>

<%@ include file="footer.jspf" %>
