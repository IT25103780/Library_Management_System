<%@ page pageEncoding="UTF-8" %>
<%@ include file="header.jspf" %>

<section class="section notification-section"><div class="section-heading"><div><span class="eyebrow">YOUR LIBRARY, IN THE LOOP</span><h1>A note <em>for you.</em></h1></div><form method="post" action="<%=ctx%>/action"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="read-notifications"><button class="button ghost small">Mark all as read</button></form></div><div class="notification-list"><%var rows=(List<Map<String,Object>>)request.getAttribute("rows");for(var n:rows){%><article class="notification <%=DB.id(n,"is_read")==0?"unread":""%>"><div class="notification-icon">&#10022;</div><div><span class="eyebrow"><%=Web.date(n.get("created_at"))%></span><h3><%=Web.e(n.get("title"))%></h3><p><%=Web.e(n.get("message"))%></p><a href="<%=ctx%><%=Web.e(ModuleAccess.safeLink(Objects.toString(n.get("link"),"/home")))%>">View details &#8594;</a></div><%if(DB.id(n,"is_read")==0){%><form method="post" action="<%=ctx%>/action"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="read-notifications"><input type="hidden" name="id" value="<%=n.get("id")%>"><button class="text-button">Mark read</button></form><%}%></article><%}if(rows.isEmpty()){%><div class="empty"><h2>All quiet for now.</h2><p>Borrowing updates, receipts, and reminders will appear here.</p></div><%}%></div><p class="micro">In-app updates check automatically while you are signed in. Times are shown in Sri Lanka time.</p></section>

<%@ include file="footer.jspf" %>
