<%@ page pageEncoding="UTF-8" %>
<%@ include file="header.jspf" %>

<section class="section"><div class="profile-header"><span class="profile-monogram"><%=Web.e(user.get("name").toString().substring(0,1))%></span><div><span class="eyebrow">YOUR LUMINA ACCOUNT</span><h1><%=Web.e(user.get("name"))%></h1><p><%=Web.e(user.get("email"))%> · Account #<%=user.get("id")%></p></div></div><div class="two-panels"><section class="panel"><h3>The details that matter.</h3><form method="post" action="<%=ctx%>/profile"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="operation" value="details"><label>Full name<input name="name" required maxlength="180" value="<%=Web.e(user.get("name"))%>"></label><label>Phone<input name="phone" required maxlength="40" value="<%=Web.e(user.get("phone"))%>"></label><label>Address<textarea name="address" required maxlength="500"><%=Web.e(user.get("address"))%></textarea></label><button class="button">Save details</button></form></section><section class="panel"><h3>A little extra security.</h3><form method="post" action="<%=ctx%>/profile"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="operation" value="password"><label>Current password<input type="password" name="current_password" required autocomplete="current-password"></label><label>New password<input data-strong-password type="password" name="password" minlength="10" maxlength="128" required autocomplete="new-password"></label><label>Confirm new password<input type="password" name="confirm_password" minlength="10" maxlength="128" required autocomplete="new-password"></label><button class="button ghost">Change password</button></form></section></div></section>

<%@ include file="footer.jspf" %>
