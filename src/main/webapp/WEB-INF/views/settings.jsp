<%@ page pageEncoding="UTF-8" %>
<%@ include file="header.jspf" %>

<section class="section narrow"><span class="eyebrow">THE WAY YOUR LIBRARY WORKS</span><h1>Thoughtful <em>defaults.</em></h1><section class="panel"><h3>Borrowing policies</h3><form method="post" action="<%=ctx%>/settings"><input type="hidden" name="csrf" value="<%=csrf%>"><%Map<String,String> labels=Map.of("physical_days","Physical borrowing duration (days)","max_loans","Maximum open physical loans","fine_per_day","Overdue fine per started day (LKR)","reservation_hours","Reservation collection window (hours)");for(var row:(List<Map<String,Object>>)request.getAttribute("rows")){%><label><%=labels.get(row.get("setting_key"))%><input type="number" min="1" max="10000" name="<%=row.get("setting_key")%>" value="<%=row.get("setting_value")%>" required></label><%}%><button class="button">Save policies</button></form></section><section class="panel"><h3>Service configuration</h3><dl class="order-lines"><div><dt>Database mode</dt><dd><%=ViewUtils.e(AppConfig.get("db.mode","demo"))%></dd></div><div><dt>Payment mode</dt><dd><%=ViewUtils.e(AppConfig.get("payment.mode","demo"))%></dd></div><div><dt>Email delivery</dt><dd><%=MailService.enabled()?"Configured":"Not configured"%></dd></div></dl><p class="micro">External service settings are managed in the server's lumina.properties file. Restart Tomcat after changing them.</p></section><section class="panel"><h3>A note to the library.</h3><form method="post" action="<%=ctx%>/action"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="announce"><label>Announcement title<input name="title" required maxlength="180"></label><label>Message<textarea name="message" required maxlength="1000" rows="4"></textarea></label><button class="button">Notify active accounts</button></form></section><section class="panel"><h3>Recent audit history</h3><div class="table-wrap"><table><thead><tr><th>Who</th><th>Action</th><th>Details</th><th>When</th></tr></thead><tbody><%for(var event:(List<Map<String,Object>>)request.getAttribute("audit")){%><tr><td><%=ViewUtils.e(event.get("username"))%></td><td><%=ViewUtils.e(event.get("action"))%></td><td><%=ViewUtils.e(event.get("details"))%></td><td><%=ViewUtils.date(event.get("created_at"))%></td></tr><%}%></tbody></table></div></section></section>

