<%@ page pageEncoding="UTF-8" %>
<%@ include file="header.jspf" %>

<%var book=(Map<String,Object>)request.getAttribute("book");int days=((Number)book.get("duration_days")).intValue();%><section class="section"><a class="breadcrumb" href="<%=ctx%>/catalog">&#8592; Back to the collection</a><div class="book-detail"><div class="detail-stage"><div class="detail-orbit"></div><div class="book-object detail-cover"><img src="<%=ctx%>/cover?id=<%=book.get("id")%>" alt="<%=ViewUtils.e(book.get("title"))%> cover"><span class="book-spine"></span></div><span class="stage-label">THE LUMINA COLLECTION</span></div><div class="detail-copy"><span class="eyebrow"><%=ViewUtils.e(book.get("category"))%> / <%=ViewUtils.e(book.get("format"))%></span><h1><%=ViewUtils.e(book.get("title"))%></h1><p class="byline">by <%=ViewUtils.e(book.get("author"))%></p><p class="description"><%=ViewUtils.e(book.get("description"))%></p><dl class="book-facts"><div><dt>Publisher</dt><dd><%=ViewUtils.e(book.get("publisher"))%></dd></div><div><dt>Published</dt><dd><%=book.get("publication_year")%></dd></div><div><dt>ISBN</dt><dd><%=ViewUtils.e(book.get("isbn"))%></dd></div><div><dt>Edition</dt><dd><%=ViewUtils.e(book.get("edition"))%></dd></div></dl><%=BookQr.html(AppConfig.get("app.url","http://localhost:8080/lumina")+"/book?id="+book.get("id"))%></div><aside class="borrow-panel"><span class="eyebrow">MAKE IT YOUR NEXT READ</span><h3>A chapter awaits.</h3><%if(book.get("pdf_path")!=null&&!book.get("format").equals("PHYSICAL")){%><div class="price"><%=ViewUtils.money(book.get("fee"))%><small>for <%=days%> days of digital reading</small></div><%if(user!=null){%><form method="post" action="<%=ctx%>/action"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="borrow"><input type="hidden" name="book_id" value="<%=book.get("id")%>"><label>Borrowing period<select name="days"><%for(int multiple:new int[]{1,2,4}){%><option value="<%=days*multiple%>"><%=days*multiple%> days · <%=ViewUtils.money(new java.math.BigDecimal(book.get("fee").toString()).multiply(java.math.BigDecimal.valueOf(multiple)))%></option><%}%></select></label><button class="button full">Borrow online &#8594;</button></form><%}else{%><a class="button full" href="<%=ctx%>/login">Sign in to borrow &#8594;</a><%}%><p class="micro">Your reading period begins after confirmed payment. Read inside your personal bookshelf.</p><%}%><%if(!book.get("format").equals("DIGITAL")){%><div class="physical-option"><h4>Prefer a physical copy?</h4><p><%=book.get("available")%> copies available across our branches.</p><%if(user!=null){%><form method="post" action="<%=ctx%>/action"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="reserve"><input type="hidden" name="book_id" value="<%=book.get("id")%>"><label>Collection branch<select name="branch_id"><%for(var br:(List<Map<String,Object>>)request.getAttribute("branches")){%><option value="<%=br.get("id")%>"><%=ViewUtils.e(br.get("name"))%> · <%=br.get("available")%> available</option><%}%></select></label><button class="button ghost full">Reserve a copy</button></form><%}else{%><a href="<%=ctx%>/login">Sign in to reserve &#8594;</a><%}%></div><%}%></aside></div></section>

<%@ include file="footer.jspf" %>
