<%@ page pageEncoding="UTF-8" %>
<%@ include file="header.jspf" %>
<%var b=(Map<String,Object>)request.getAttribute("book");%><section class="section"><a class="breadcrumb" href="<%=ctx%>/catalog">&#8592; Back to catalogue</a><div class="module-book"><img class="detail-cover" src="<%=ctx%>/cover?id=<%=b.get("id")%>" alt="Cover of <%=Web.e(b.get("title"))%>"><div><span class="eyebrow"><%=Web.e(b.get("category"))%></span><h1><%=Web.e(b.get("title"))%></h1><p class="book-author">By <%=Web.e(b.get("author"))%></p><p><%=Web.e(b.get("description"))%></p><dl class="book-metadata"><div><dt>ISBN / reference</dt><dd><%=Web.e(b.get("isbn"))%></dd></div><div><dt>Publisher</dt><dd><%=Web.e(b.get("publisher"))%></dd></div><div><dt>Published</dt><dd><%=b.get("publication_year")%></dd></div><div><dt>Edition</dt><dd><%=Web.e(b.get("edition"))%></dd></div></dl><%if(ModuleAccess.is("books")&&ModuleAccess.canManage(user)){%><a class="button" href="<%=ctx%>/book-edit?id=<%=b.get("id")%>">Edit this book</a><%}%></div></div><div class="section-heading"><h2>Find a copy</h2><p>Availability at each library branch</p></div><div class="tool-grid"><%for(var br:(List<Map<String,Object>>)request.getAttribute("branches")){%><article class="panel"><h3><%=Web.e(br.get("name"))%></h3><p><%=Web.e(br.get("address"))%></p><span class="pill"><%=br.get("available")%> copies available</span><p class="micro"><%=Web.e(br.get("hours"))%></p><%if(ModuleAccess.is("borrowing")&&DB.id(br,"available")>0){if(user==null){%><a class="button small" href="<%=ctx%>/login">Sign in to borrow</a><%}else{%><form method="post" action="<%=ctx%>/action"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="borrow"><input type="hidden" name="book_id" value="<%=b.get("id")%>"><input type="hidden" name="branch_id" value="<%=br.get("id")%>"><button class="button small">Borrow this book</button></form><%}}else if(DB.id(br,"available")==0){%><p>Currently unavailable at this branch.</p><%}%></article><%}%></div></section>
<%@ include file="footer.jspf" %>
