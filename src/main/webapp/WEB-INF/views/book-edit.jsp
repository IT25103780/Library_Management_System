<%@ page pageEncoding="UTF-8" %>
<%@ include file="header.jspf" %>

<%var book=(Map<String,Object>)request.getAttribute("book");%><section class="section"><a class="breadcrumb" href="<%=ctx%>/manage?entity=books">&#8592; Back to books</a><div class="section-heading"><div><span class="eyebrow">GROW THE COLLECTION</span><h1><%=book==null?"A new story":"Refine the details"%><em>.</em></h1></div></div><form method="post" action="<%=ctx%>/book-edit" enctype="multipart/form-data" class="book-editor" data-upload-form><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="id" value="<%=book==null?0:book.get("id")%>"><aside class="panel upload-panel"><span class="eyebrow">FIRST IMPRESSIONS</span><img id="cover-preview" src="<%=ctx%><%=book==null?"/assets/cover-1.svg":"/cover?id="+book.get("id")%>" alt="Book cover preview"><label class="upload-label">Choose thumbnail<input type="file" name="cover" accept="image/jpeg,image/png" id="cover-input"><small>JPG or PNG Â· up to 8 MB</small></label><label class="upload-label pdf-upload">Book PDF<input type="file" name="pdf" accept="application/pdf"><small>Unencrypted PDF Â· up to 50 MB</small></label><%if(book!=null&&book.get("pdf_path")!=null){%><p class="micro">A PDF is stored for this book. Upload a file to replace it, or leave blank to retain it.</p><%}%></aside><div class="panel"><h3>The book, in detail.</h3><div class="form-grid"><%for(String field:List.of("title","isbn","edition")){%><label><%=field.equals("isbn")?"Catalog reference":field.substring(0,1).toUpperCase()+field.substring(1)%><input <%=field.equals("isbn")?"readonly aria-describedby=\"reference-help\"":""%> name="<%=field%>" value="<%=book==null?(field.equals("edition")?"First edition":field.equals("isbn")?ViewUtils.e(request.getAttribute("nextReference")):""):ViewUtils.e(book.get(field))%>" maxlength="<%=field.equals("title")?240:field.equals("isbn")?40:60%>" required><%if(field.equals("isbn")){%><small id="reference-help"><%=book==null?"Assigned automatically when saved. The number may advance if another book is saved first.":"This book reference is fixed."%></small><%}%></label><%}%><label>Publication year<input type="number" name="publication_year" min="1" max="2100" value="<%=book==null?2026:book.get("publication_year")%>" required></label><%for(String table:List.of("authors","categories","publishers")){String field=table.equals("categories")?"category_id":table.substring(0,table.length()-1)+"_id";%><label><%=table%><select name="<%=field%>" required><%for(var record:(List<Map<String,Object>>)request.getAttribute(table)){%><option value="<%=record.get("id")%>" <%=book!=null&&Objects.equals(record.get("id"),book.get(field))?"selected":""%>><%=ViewUtils.e(record.get("name"))%></option><%}%></select></label><%}%><label>Format<select name="format"><%for(String format:List.of("BOTH","DIGITAL","PHYSICAL")){%><option <%=book!=null&&format.equals(book.get("format"))?"selected":""%>><%=format%></option><%}%></select></label></div><label>Description<textarea name="description" maxlength="4000" rows="5" required><%=book==null?"":ViewUtils.e(book.get("description"))%></textarea></label><h3>Borrowing &amp; availability</h3><div class="form-grid"><label>Base digital fee (LKR)<input type="number" name="fee" min="0" max="9999999" step="0.01" value="<%=book==null?250:book.get("fee")%>" required></label><label>Base duration (days)<input type="number" name="duration_days" min="1" max="365" value="<%=book==null?7:book.get("duration_days")%>" required></label><label>Add physical copies<input type="number" name="copies" min="0" max="500" value="0" required></label><label>Copies belong to<select name="branch_id"><%for(var br:(List<Map<String,Object>>)request.getAttribute("branches")){%><option value="<%=br.get("id")%>"><%=ViewUtils.e(br.get("name"))%></option><%}%></select></label></div><p class="micro">Readers may choose the base duration, twice the duration, or four times the duration. Prices scale proportionally.</p><progress id="upload-progress" max="100" value="0" hidden></progress><p id="upload-status" role="status"></p><button class="button" type="submit">Save book &amp; files &#8594;</button></div></form></section>

<%@ include file="footer.jspf" %>
