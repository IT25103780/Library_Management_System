<%@ page pageEncoding="UTF-8" %>
<%@ include file="header.jspf" %>
<section class="section"><span class="eyebrow">YOUR READING JOURNEY</span><h1>My borrowing history</h1><p>Check your due dates and the books you have returned.</p><div class="panel"><div class="table-wrap"><table><thead><tr><th>Book</th><th>Issued</th><th>Due</th><th>Returned</th><th>Status</th></tr></thead><tbody><%var rows=(List<Map<String,Object>>)request.getAttribute("loans");for(var row:rows){%><tr><td><%=Web.e(row.get("title"))%></td><td><%=Web.date(row.get("start_at"))%></td><td><%=Web.date(row.get("due_at"))%></td><td><%=Web.date(row.get("returned_at"))%></td><td><span class="pill"><%=Web.e(row.get("status"))%></span></td></tr><%}%></tbody></table><%if(rows.isEmpty()){%><div class="empty"><h3>Your first chapter is waiting.</h3><p>Visit the library desk to borrow a book.</p><a class="button" href="<%=ctx%>/catalog">Browse books</a></div><%}%></div></div></section>
<%@ include file="footer.jspf" %>
