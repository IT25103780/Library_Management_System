<%@ page pageEncoding="UTF-8" %>
<%@ include file="header.jspf" %>

<section class="section"><div class="shelf-heading"><div><span class="eyebrow">YOUR PERSONAL READING ROOM</span><h1>Between the covers,<br><em>another world.</em></h1><p>Pick up where you left off. Your next quiet moment is here.</p></div><a class="button ghost" href="<%=ctx%>/catalog">Find another story &#8599;</a></div><div class="shelf-grid"><%var loans=(List<Map<String,Object>>)request.getAttribute("loans");for(var loan:loans){boolean active=loan.get("status").equals("ACTIVE")&&((Timestamp)loan.get("due_at")).after(BusinessRules.now());%><article class="shelf-card"><a class="shelf-cover book-object" href="<%=ctx%>/book?id=<%=loan.get("book_id")%>"><img src="<%=ctx%>/cover?id=<%=loan.get("book_id")%>" alt="<%=ViewUtils.e(loan.get("title"))%> cover" loading="lazy"></a><div><span class="eyebrow"><%=ViewUtils.e(loan.get("kind"))%> BORROWING</span><h3><%=ViewUtils.e(loan.get("title"))%></h3><p><%=ViewUtils.e(loan.get("author"))%></p><span class="pill <%=active?"success":""%>"><%=ViewUtils.e(active?"ACTIVE":loan.get("status").equals("ACTIVE")?"EXPIRED":loan.get("status"))%></span><dl><dt>Borrowed</dt><dd><%=ViewUtils.date(loan.get("start_at"))%></dd><dt>Due / expires</dt><dd><%=ViewUtils.date(loan.get("due_at"))%></dd></dl><%if(loan.get("kind").equals("DIGITAL")){if(active){%><a class="button" href="<%=ctx%>/reader?id=<%=loan.get("id")%>">Read Now &#8594;</a><small class="reading-note">Continue from page <%=loan.get("page_number")%></small><%}else{%><a class="button ghost" href="<%=ctx%>/book?id=<%=loan.get("book_id")%>">Borrow again &#8594;</a><%}}else{%><p class="micro">Physical books are issued and returned at the library service desk.</p><%}%></div></article><%}if(loans.isEmpty()){%><div class="empty wide"><span class="empty-mark">&#10022;</span><h2>A shelf full of possibility.</h2><p>Your borrowed books will appear here. Start with something that catches your curiosity.</p><a class="button" href="<%=ctx%>/catalog">Discover your first read &#8594;</a></div><%}%></div></section>

<%@ include file="footer.jspf" %>
