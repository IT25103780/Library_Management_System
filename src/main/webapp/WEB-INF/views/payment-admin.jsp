<%@ page pageEncoding="UTF-8" %><%@ include file="header.jspf" %>
<section class="section"><div class="section-heading"><div><span class="eyebrow">THE PAYMENT DESK</span><h1>Every transaction, <em>in view.</em></h1></div><a class="button ghost" href="<%=ctx%>/reports?type=payments">Payment reports</a></div><div class="panel"><div class="section-heading"><h3>Payments &amp; refund records</h3><input type="search" class="table-search" placeholder="Search transactions…" aria-label="Search transactions"></div><div class="table-wrap"><table><thead><tr><th>Order</th><th>Reader</th><th>Book / fine</th><th>Amount</th><th>Provider</th><th>Status</th><th>Date</th><th>Reconciliation</th></tr></thead><tbody><%for(var p:(List<Map<String,Object>>)request.getAttribute("rows")){%><tr><td>#<%=p.get("id")%></td><td><%=ViewUtils.e(p.get("name"))%></td><td><%=p.get("title")==null?"Fine #"+p.get("fine_id"):ViewUtils.e(p.get("title"))%></td><td><%=ViewUtils.money(p.get("amount"))%></td><td><%=ViewUtils.e(p.get("provider"))%></td><td><span class="pill"><%=ViewUtils.e(p.get("status"))%></span></td><td><%=ViewUtils.date(p.get("created_at"))%></td><td><%if(p.get("status").equals("SUCCESSFUL")){%><details class="row-editor"><summary>Record completed refund</summary><p class="micro">Complete the refund with the payment provider first. This records it and updates borrowing access; it does not send money.</p><form method="post" action="<%=ctx%>/action" data-confirm="Confirm this refund has already been completed with the payment provider?"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="record-refund"><input type="hidden" name="id" value="<%=p.get("id")%>"><label>Provider refund reference<input name="reference" required maxlength="120"></label><button class="button small">Record refund</button></form></details><%}else{%><%=ViewUtils.e(p.get("provider_ref"))%><%}%></td></tr><%}%></tbody></table></div></div></section>
<%@ include file="footer.jspf" %>