<%@ page pageEncoding="UTF-8" %>
<%@ include file="header.jspf" %>

<section class="catalog-intro section"><div><span class="eyebrow">THE LUMINA COLLECTION</span><h1>Follow your <em>curiosity.</em></h1><p>A new perspective is only a page away.</p></div><div class="catalog-seal">L<span>&#10022;</span></div></section><section class="section catalog-layout"><aside class="filter-panel"><h3>Find your next read</h3><form method="get" action="<%=ctx%>/catalog"><label>Search the collection<input type="search" name="q" placeholder="Title, author, ISBN…" value="<%=ViewUtils.e(request.getParameter("q"))%>"></label><label>Category<select name="category"><option value="">All categories</option><%for(var cat:(List<Map<String,Object>>)request.getAttribute("categories")){%><option value="<%=cat.get("id")%>" <%=cat.get("id").toString().equals(request.getParameter("category"))?"selected":""%>><%=ViewUtils.e(cat.get("name"))%></option><%}%></select></label><label>Book format<select name="format"><option value="">All formats</option><option value="DIGITAL" <%= "DIGITAL".equals(request.getParameter("format"))?"selected":""%>>Digital books</option><option value="PHYSICAL" <%= "PHYSICAL".equals(request.getParameter("format"))?"selected":""%>>Physical books</option></select></label><label>Branch<select name="branch"><option value="">All branches</option><%for(var br:(List<Map<String,Object>>)request.getAttribute("branches")){%><option value="<%=br.get("id")%>" <%=br.get("id").toString().equals(request.getParameter("branch"))?"selected":""%>><%=ViewUtils.e(br.get("name"))%></option><%}%></select></label><label>Sort by<select name="sort"><option value="newest">Newest additions</option><option value="title" <%= "title".equals(request.getParameter("sort"))?"selected":""%>>Title A–Z</option></select></label><label class="check"><input type="checkbox" name="available" value="1" <%= "1".equals(request.getParameter("available"))?"checked":""%>> Available titles only</label><button class="button full">Apply filters</button><a class="form-link" href="<%=ctx%>/catalog">Clear filters</a></form><div class="aside-note">There is always<br><em>one more story.</em><span>&#10022;</span></div></aside><div><div class="results-heading"><span><%=request.getAttribute("total")%> titles to discover</span><span>CURATED WITH CURIOSITY</span></div><div class="book-grid"><%for(Map<String,Object> book:(List<Map<String,Object>>)request.getAttribute("books")){%><article class="book-card"><a class="book-object" href="<%=ctx%>/book?id=<%=book.get("id")%>"><img loading="lazy" src="<%=ctx%>/cover?id=<%=book.get("id")%>" alt="<%=ViewUtils.e(book.get("title"))%> cover" width="300" height="420"><span class="book-spine"></span></a><div class="book-meta"><span class="eyebrow"><%=ViewUtils.e(book.get("category"))%></span><h3><a href="<%=ctx%>/book?id=<%=book.get("id")%>"><%=ViewUtils.e(book.get("title"))%></a></h3><p><%=ViewUtils.e(book.get("author"))%></p><div class="book-bottom"><span class="pill"><%=ViewUtils.e(book.get("format"))%></span><a href="<%=ctx%>/book?id=<%=book.get("id")%>" aria-label="View book">&#8599;</a></div></div></article><%}%></div><%if(((List<?>)request.getAttribute("books")).isEmpty()){%><div class="empty"><h3>A different search, perhaps?</h3><p>No books match these filters. Try another author or category.</p></div><%}%><div class="pagination" data-page="<%=request.getAttribute("page")%>" data-total="<%=request.getAttribute("total")%>"><button class="button ghost" data-page-step="-1">&#8592; Previous</button><span>Page <%=request.getAttribute("page")%></span><button class="button ghost" data-page-step="1">Next &#8594;</button></div></div></section>

<%@ include file="footer.jspf" %>
