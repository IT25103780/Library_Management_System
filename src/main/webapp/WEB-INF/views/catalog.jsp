<%@ page pageEncoding="UTF-8" %>
<%@ include file="header.jspf" %>
<section class="section"><div class="section-heading"><div><span class="eyebrow">A WORLD WITHIN REACH</span><h1>Explore the collection<span class="hero-period">.</span></h1><p>Find a title, meet an author and discover what is available.</p></div><%if(ModuleAccess.is("books")&&ModuleAccess.canManage(user)){%><a class="button" href="<%=ctx%>/book-edit">Add a book +</a><%}%></div>
<form action="<%=ctx%>/catalog" method="get" class="catalog-filters panel"><label>Search<input name="q" type="search" placeholder="Title, ISBN, author or publisher" value="<%=Web.e(request.getParameter("q"))%>"></label><label>Category<select name="category"><option value="">All categories</option><%for(var c:(List<Map<String,Object>>)request.getAttribute("categories")){%><option value="<%=c.get("id")%>" <%=c.get("id").toString().equals(request.getParameter("category"))?"selected":""%>><%=Web.e(c.get("name"))%></option><%}%></select></label><label>Branch<select name="branch"><option value="">All branches</option><%for(var br:(List<Map<String,Object>>)request.getAttribute("branches")){%><option value="<%=br.get("id")%>" <%=br.get("id").toString().equals(request.getParameter("branch"))?"selected":""%>><%=Web.e(br.get("name"))%></option><%}%></select></label><label>Availability<select name="available"><option value="">All books</option><option value="1" <%="1".equals(request.getParameter("available"))?"selected":""%>>Available now</option></select></label><button class="button">Search</button><a class="text-button" href="<%=ctx%>/catalog">Clear</a></form>
<p class="result-count"><%=request.getAttribute("total")%> titles found</p><div class="catalog-grid"><%var books=(List<Map<String,Object>>)request.getAttribute("books");for(var b:books){%><a class="catalog-card" href="<%=ctx%>/book?id=<%=b.get("id")%>"><div class="catalog-cover"><img src="<%=ctx%>/cover?id=<%=b.get("id")%>" alt="Cover of <%=Web.e(b.get("title"))%>" loading="lazy"></div><div class="catalog-info"><span class="eyebrow"><%=Web.e(b.get("category"))%></span><h3><%=Web.e(b.get("title"))%></h3><p><%=Web.e(b.get("author"))%></p><span class="pill <%=DB.id(b,"available")>0?"available":"waiting"%>"><%=DB.id(b,"available")>0?b.get("available")+" copies available":"Currently unavailable"%></span></div></a><%}if(books.isEmpty()){%><div class="empty"><h3>No matching books.</h3><p>Try a different search or clear the filters.</p></div><%}%></div><div class="pagination" data-page="<%=request.getAttribute("page")%>" data-total="<%=request.getAttribute("total")%>"><button class="button ghost" data-page-step="-1">Previous</button><span>Page <%=request.getAttribute("page")%></span><button class="button ghost" data-page-step="1">Next</button></div></section>
<%@ include file="footer.jspf" %>
