<%@ page pageEncoding="UTF-8" %>
<%@ include file="header.jspf" %>

<%var payment=(Map<String,Object>)request.getAttribute("payment");String state=payment.get("status").toString();%><section class="section result-section" <%=state.equals("PENDING")?"data-poll-payment":""%>><div class="result-symbol"><%=state.equals("SUCCESSFUL")?"&#10003;":state.equals("PENDING")?"&#9676;":"&#215;"%></div><span class="eyebrow">ORDER #<%=payment.get("id")%></span><h1><%=state.equals("SUCCESSFUL")?"Your next chapter is ready.":state.equals("PENDING")?"Confirming your payment.":"Let's try that again."%></h1><p><%=state.equals("SUCCESSFUL")?"Payment confirmed. Your receipt is saved and your account has been updated.":state.equals("PENDING")?"We have not received a confirmed payment yet. This page checks for an update automatically. You can also find this order in PaymentGatewayService.":"This payment did not activate borrowing. Review your payment history to retry."%></p><%if(state.equals("SUCCESSFUL")){if(payment.get("loan_id")!=null){%><a class="button" href="<%=ctx%>/reader?id=<%=payment.get("loan_id")%>">Read Now &#8594;</a><%}%><a class="button ghost" href="<%=ctx%>/receipt?id=<%=payment.get("id")%>">View receipt</a><%}else if(state.equals("PENDING")){%><a class="button" href="<%=ctx%>/checkout?id=<%=payment.get("id")%>">Return to checkout</a><%}%><a class="form-link" href="<%=ctx%>/payments">View payment history</a><%if(payment.get("provider").equals("DEMO")){%><div class="notice">Demonstration transaction. No money was charged.</div><%}%></section>

<%@ include file="footer.jspf" %>
