<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" import="java.util.*,java.sql.*,lk.lumina.*" %>
<% String ctx=request.getContextPath(), current=Objects.toString(request.getAttribute("path"),""); Map<String,Object> user=(Map<String,Object>)request.getAttribute("user"); String csrf=Objects.toString(session.getAttribute("csrf"),""); boolean staff=Web.staff(user), manager=Web.manager(user); %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#172e3d"><title><%=Web.e(ModuleAccess.TITLE)%> | Lumina Library</title><link rel="icon" href="<%=ctx%>/assets/mark.svg" type="image/svg+xml"><link rel="stylesheet" href="<%=ctx%>/assets/style.css"><link rel="stylesheet" href="<%=ctx%>/assets/module.css"><script src="<%=ctx%>/assets/module.js" defer></script></head>
<body data-context="<%=ctx%>" data-signed-in="<%=user!=null%>"><a class="skip" href="#main">Skip to content</a>
<header class="topbar"><a class="brand" href="<%=ctx%>/home"><img src="<%=ctx%>/assets/mark.svg" alt="" width="38" height="38"><span>LUMINA<small>LIBRARY MANAGEMENT</small></span></a><nav class="public-nav" aria-label="Main navigation"><a class="<%=Set.of("/","/home","/dashboard").contains(current)?"active":""%>" href="<%=ctx%>/home">Home</a><a class="<%=current.equals("/catalog")?"active":""%>" href="<%=ctx%>/catalog">Book catalogue</a><%if(user!=null){%><a href="<%=ctx%>/profile">My account</a><%}%></nav><div class="nav-actions"><%if(user==null){%><a class="button small" href="<%=ctx%>/login">Sign in &#8599;</a><%}else{%><a class="notification-link" href="<%=ctx%>/notifications">Notifications <span id="notification-count" hidden></span></a><span class="user-label"><%=Web.e(user.get("name"))%></span><form method="post" action="<%=ctx%>/logout" class="inline"><input type="hidden" name="csrf" value="<%=csrf%>"><button class="text-button" type="submit">Sign out</button></form><%}%><button class="menu-toggle" aria-label="Toggle navigation" aria-expanded="false">&#9776;</button></div></header>
<%if(user!=null){%><nav class="workspace-nav" aria-label="Module navigation"><a class="<%=Set.of("/","/home","/dashboard").contains(current)?"selected":""%>" href="<%=ctx%>/home">Overview</a><%for(String[] link:ModuleAccess.LINKS){if(ModuleAccess.linkVisible(link[1],user)){String full=current+(request.getParameter("entity")==null?"":"?entity="+request.getParameter("entity"));%><a class="<%=full.equals(link[1])?"selected":""%>" href="<%=ctx%><%=link[1]%>"><%=Web.e(link[0])%></a><%}}%></nav><%}%>
<%if(session.getAttribute("flash")!=null){%><div class="flash" role="status"><span class="status-dot"></span><%=Web.e(session.getAttribute("flash"))%><button aria-label="Dismiss message" data-dismiss>&#215;</button></div><%session.removeAttribute("flash");}%>
<main id="main">
