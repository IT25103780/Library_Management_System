<%@ page pageEncoding="UTF-8" %>
<%@ include file="header.jspf" %>

<%String entity=request.getAttribute("entity").toString();var editing=(Map<String,Object>)request.getAttribute("editing");%><section class="section"><div class="section-heading"><div><span class="eyebrow">MANAGE YOUR LIBRARY</span><h1><%=Web.e(entity.substring(0,1).toUpperCase()+entity.substring(1))%></h1></div><%if(entity.equals("books")){%><a class="button" href="<%=ctx%>/book-edit">Add a book &#43;</a><%}%></div><nav class="tabs" aria-label="Management sections"><%for(String t:ModuleAccess.ENTITIES){%><a class="<%=entity.equals(t)?"selected":""%>" href="<%=ctx%>/manage?entity=<%=t%>"><%=t.substring(0,1).toUpperCase()+t.substring(1)%></a><%}%></nav><%if(!entity.equals("books")){%><details class="panel edit-panel" <%=editing!=null?"open":""%>><summary><%=editing==null?"Add a new record":"Edit record #"+editing.get("id")%> <span>&#43;</span></summary><form method="post" action="<%=ctx%>/manage" class="record-form"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="entity" value="<%=entity%>"><input type="hidden" name="id" value="<%=editing==null?0:editing.get("id")%>"><div class="form-grid"><%if(Web.ENTITIES.containsKey(entity)){for(String field:Web.ENTITIES.get(entity)){%><label><%=field.substring(0,1).toUpperCase()+field.substring(1)%><input name="<%=field%>" value="<%=editing==null?"":Web.e(editing.get(field))%>" <%=field.equals("name")?"required":""%> maxlength="<%=field.equals("description")?1000:field.equals("address")?500:field.equals("phone")?40:180%>"></label><%}}else if(entity.equals("users")){for(String field:List.of("name","email","username","phone","address")){%><label><%=field%><input name="<%=field%>" value="<%=editing==null?"":Web.e(editing.get(field))%>" <%=Set.of("phone","address").contains(field)?"":"required"%> maxlength="<%=field.equals("address")?500:field.equals("phone")?40:field.equals("username")?40:180%>"></label><%}if(editing==null){%><label>Initial password<input data-strong-password type="password" name="password" minlength="10" maxlength="128" required autocomplete="new-password"></label><%}%><label>Member type<select name="member_type"><%for(String mt:List.of("STUDENT","STAFF")){%><option <%=editing!=null&&mt.equals(editing.get("member_type"))?"selected":""%>><%=mt%></option><%}%></select></label><label>Role<select name="role"><%for(String role:List.of("READER","LIBRARIAN","BRANCH_MANAGER","MANAGEMENT","ADMIN")){%><option <%=editing!=null&&role.equals(editing.get("role"))?"selected":""%>><%=role%></option><%}%></select></label><label>Assigned branch<select name="branch_id"><option value="">No branch</option><%for(var br:(List<Map<String,Object>>)request.getAttribute("branches")){%><option value="<%=br.get("id")%>" <%=editing!=null&&Objects.equals(br.get("id"),editing.get("branch_id"))?"selected":""%>><%=Web.e(br.get("name"))%></option><%}%></select></label><%}else{%><label>Book<select name="book_id" required><%for(var b:(List<Map<String,Object>>)request.getAttribute("books")){%><option value="<%=b.get("id")%>"><%=Web.e(b.get("title"))%></option><%}%></select></label><label>Branch<select name="branch_id" required><%for(var br:(List<Map<String,Object>>)request.getAttribute("branches")){%><option value="<%=br.get("id")%>"><%=Web.e(br.get("name"))%></option><%}%></select></label><label>Quantity<input type="number" name="quantity" min="1" max="500" value="1" required></label><%if(entity.equals("purchases")){%><label>Supplier<select name="supplier_id" required><%for(var supplier:(List<Map<String,Object>>)request.getAttribute("suppliers")){%><option value="<%=supplier.get("id")%>"><%=Web.e(supplier.get("name"))%></option><%}%></select></label><label>Invoice / order reference<input name="invoice_ref" maxlength="100"></label><label>Notes<input name="notes" maxlength="500"></label><label>Unit cost (LKR)<input type="number" name="unit_cost" min="0" max="9999999" step="0.01" required></label><%}}%></div><button class="button">Save record</button></form></details><%}%><%if(entity.equals("purchases")){%><details class="panel edit-panel"><summary>New purchase with multiple books</summary><form method="post" action="<%=ctx%>/action" class="record-form"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="purchase-batch"><div class="form-grid"><label>Supplier<select name="supplier_id" required><%for(var supplier:(List<Map<String,Object>>)request.getAttribute("suppliers")){%><option value="<%=supplier.get("id")%>"><%=Web.e(supplier.get("name"))%></option><%}%></select></label><label>Branch<select name="branch_id"><%for(var br:(List<Map<String,Object>>)request.getAttribute("branches")){%><option value="<%=br.get("id")%>"><%=Web.e(br.get("name"))%></option><%}%></select></label><label>Invoice reference<input name="invoice_ref" maxlength="100" placeholder="Generated if blank"></label><label>Notes<input name="notes" maxlength="500"></label></div><p>Enter quantities for the books being ordered. Leave unused lines at zero. Lines share an invoice and are saved together.</p><%for(int i=0;i<5;i++){%><div class="form-grid"><label>Book <%=i+1%><select name="book<%=i%>"><%for(var b:(List<Map<String,Object>>)request.getAttribute("books")){%><option value="<%=b.get("id")%>"><%=Web.e(b.get("title"))%></option><%}%></select></label><label>Quantity<input name="quantity<%=i%>" type="number" min="0" max="500" value="0"></label><label>Unit cost<input name="cost<%=i%>" type="number" min="0" step="0.01" value="0"></label></div><%}%><button class="button">Save purchase</button></form></details><%}%><section class="panel"><div class="section-heading"><h3>Library records</h3><input class="table-search" type="search" placeholder="Search these records…" aria-label="Search records"></div><%var rows=(List<Map<String,Object>>)request.getAttribute("rows");request.setAttribute("tableActions",true);%><div class="table-wrap"><table><thead><tr><%if(!rows.isEmpty())for(String key:rows.get(0).keySet())if(ModuleAccess.showColumn(key)){%><th><%=Web.e(key.replace('_',' '))%></th><%}%><%if(Boolean.TRUE.equals(request.getAttribute("tableActions"))){%><th>Actions</th><%}%></tr></thead><tbody><%for(var row:rows){%><tr><%for(var cell:row.entrySet())if(ModuleAccess.showColumn(cell.getKey())){%><td><%if(cell.getKey().equals("status")||cell.getKey().equals("format")){%><span class="pill"><%=Web.e(cell.getValue())%></span><%}else if(cell.getKey().equals("isbn")){%><%=Web.e(cell.getValue())%><%}else if(cell.getKey().equals("active")){%><span class="pill"><%=((Number)cell.getValue()).intValue()==1?"Active":"Inactive"%></span><%}else if(cell.getValue() instanceof Timestamp){%><%=Web.date(cell.getValue())%><%}else{%><%=Web.e(cell.getValue())%><%}%></td><%}%><td class="row-actions"><%if(entity.equals("books")){%><a class="table-link" href="<%=ctx%>/book-edit?id=<%=row.get("id")%>">Edit</a><%}else if(Web.ENTITIES.containsKey(entity)||entity.equals("users")){%><a class="table-link" href="<%=ctx%>/manage?entity=<%=entity%>&edit=<%=row.get("id")%>">Edit</a><%}%><%if(row.containsKey("active")){%><form method="post" action="<%=ctx%>/action" data-confirm="Change this record's active status?"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="toggle"><input type="hidden" name="entity" value="<%=entity%>"><input type="hidden" name="id" value="<%=row.get("id")%>"><button class="text-button"><%=DB.id(row,"active")==1?"Deactivate":"Activate"%></button></form><%}if(entity.equals("purchases")&&Set.of("ORDERED","PARTIALLY_RECEIVED").contains(row.get("status"))){%><form method="post" action="<%=ctx%>/action"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="receive"><input type="hidden" name="id" value="<%=row.get("id")%>"><label>Quantity arriving now<input name="quantity" type="number" min="1" max="<%=DB.id(row,"quantity")-DB.id(row,"received_quantity")%>" value="<%=DB.id(row,"quantity")-DB.id(row,"received_quantity")%>" required></label><button class="button small">Receive stock</button></form><%}%>
<%if(row.containsKey("active")){%><form method="post" action="<%=ctx%>/action" data-confirm="Permanently remove this unused record? Linked records cannot be deleted."><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="delete-record"><input type="hidden" name="entity" value="<%=entity%>"><input type="hidden" name="id" value="<%=row.get("id")%>"><button class="text-button">Delete unused</button></form><%}%>
<%if(entity.equals("purchases")&&Set.of("ORDERED","PARTIALLY_RECEIVED").contains(row.get("status"))){%><details class="row-editor"><summary>Edit order</summary><form method="post" action="<%=ctx%>/action"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="purchase-update"><input type="hidden" name="id" value="<%=row.get("id")%>"><label>Quantity<input name="quantity" type="number" min="1" max="500" value="<%=row.get("quantity")%>" required></label><label>Unit cost<input name="unit_cost" type="number" step="0.01" min="0" value="<%=row.get("unit_cost")%>" required></label><label>Invoice reference<input name="invoice_ref" maxlength="100" value="<%=Web.e(row.get("invoice_ref"))%>"></label><label>Notes<input name="notes" maxlength="500" value="<%=Web.e(row.get("notes"))%>"></label><button class="button small">Save changes</button></form><form method="post" action="<%=ctx%>/action" data-confirm="Cancel the unreceived remainder of this purchase? Received copies will remain in inventory."><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="purchase-cancel"><input type="hidden" name="id" value="<%=row.get("id")%>"><button class="text-button">Cancel order</button></form></details><%}%>
<%if(entity.equals("copies")&&Set.of("AVAILABLE","MAINTENANCE","LOST","WITHDRAWN").contains(row.get("status"))){%><form method="post" action="<%=ctx%>/action"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="copy-status"><input type="hidden" name="id" value="<%=row.get("id")%>"><label>Condition<select name="status"><%for(String condition:List.of("AVAILABLE","MAINTENANCE","LOST","WITHDRAWN")){%><option <%=condition.equals(row.get("status"))?"selected":""%>><%=condition%></option><%}%></select></label><button class="button small ghost">Update</button></form><%}%>
<%if(entity.equals("copies")&&!Set.of("BORROWED","RESERVED").contains(row.get("status"))){%><details class="row-editor"><summary>Location / remove copy</summary><form method="post" action="<%=ctx%>/action"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="copy-edit"><input type="hidden" name="id" value="<%=row.get("id")%>"><label>Shelf<input name="shelf" maxlength="100" value="<%=Web.e(row.get("shelf"))%>"></label><label>Branch<select name="branch_id"><%for(var br:(List<Map<String,Object>>)request.getAttribute("branches")){%><option value="<%=br.get("id")%>" <%=Objects.equals(br.get("id"),row.get("branch_id"))?"selected":""%>><%=Web.e(br.get("name"))%></option><%}%></select></label><button class="button small">Save location</button></form><form method="post" action="<%=ctx%>/action"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="copy-delete"><input type="hidden" name="id" value="<%=row.get("id")%>"><button class="text-button">Delete unused copy</button></form></details><%}%><%if(entity.equals("users")){%><a class="table-link" href="<%=ctx%>/member?id=<%=row.get("id")%>">View activity</a><details class="row-editor"><summary>Reset account password</summary><form method="post" action="<%=ctx%>/action"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="reset-account-password"><input type="hidden" name="id" value="<%=row.get("id")%>"><label>New password<input data-strong-password type="password" name="password" minlength="10" maxlength="128" required autocomplete="new-password"></label><button class="button small">Set password</button></form></details><%}%></td></tr><%}%></tbody></table><%if(rows.isEmpty()){%><div class="empty"><h3>Nothing here just yet.</h3><p>Records will appear here as the library is used.</p></div><%}%></div></section><p class="micro">Deactivation preserves records and their history. Delete unused records only; linked records are protected.</p></section>

<%@ include file="footer.jspf" %>
