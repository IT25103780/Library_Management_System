<%@ page pageEncoding="UTF-8" %>
<%@ include file="header.jspf" %>
<%var book=(Map<String,Object>)request.getAttribute("book");%><section class="section"><a class="breadcrumb" href="<%=ctx%>/manage?entity=books">&#8592; Back to books</a><div class="section-heading"><div><span class="eyebrow">BUILD THE COLLECTION</span><h1><%=book==null?"Add a book":"Edit book details"%></h1></div></div><form method="post" action="<%=ctx%>/book-edit" enctype="multipart/form-data" class="book-editor"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="id" value="<%=book==null?0:book.get("id")%>"><input type="hidden" name="format" value="PHYSICAL"><input type="hidden" name="fee" value="0"><input type="hidden" name="duration_days" value="14"><aside class="panel upload-panel"><span class="eyebrow">BOOK COVER</span><img id="cover-preview" src="<%=ctx%><%=book==null?"/assets/cover-1.svg":"/cover?id="+book.get("id")%>" alt="Book cover preview"><label>Choose a cover<input type="file" name="cover" accept="image/jpeg,image/png" id="cover-input"><small>JPG or PNG, up to 8 MB. Optional.</small></label></aside><div class="panel"><h3>The book, in detail</h3><div class="form-grid"><%for(String field:List.of("title","isbn","edition")){%><label><%=field.equals("isbn")?"ISBN / catalogue reference":field.substring(0,1).toUpperCase()+field.substring(1)%><input name="<%=field%>" value="<%=book==null?(field.equals("edition")?"First edition":""):Web.e(book.get(field))%>" maxlength="<%=field.equals("title")?240:field.equals("isbn")?40:60%>" required><%if(field.equals("isbn")){%><small>Use a unique ISBN or library reference. Add copies for an existing title.</small><%}%></label><%}%><label>Publication year<input type="number" name="publication_year" min="1" max="2100" value="<%=book==null?2026:book.get("publication_year")%>" required></label><%for(String table:List.of("authors","categories","publishers")){String field=table.equals("categories")?"category_id":table.substring(0,table.length()-1)+"_id";%><label><%=table.substring(0,1).toUpperCase()+table.substring(1)%><select name="<%=field%>" required><%for(var record:(List<Map<String,Object>>)request.getAttribute(table)){%><option value="<%=record.get("id")%>" <%=book!=null&&Objects.equals(record.get("id"),book.get(field))?"selected":""%>><%=Web.e(record.get("name"))%></option><%}%></select></label><%}%></div><label>Description<textarea name="description" maxlength="4000" rows="5" required><%=book==null?"":Web.e(book.get("description"))%></textarea></label><h3>Physical copies</h3><div class="form-grid"><label>Number of new copies<input type="number" name="copies" min="0" max="500" value="0" required></label><label>Library branch<select name="branch_id"><%for(var br:(List<Map<String,Object>>)request.getAttribute("branches")){%><option value="<%=br.get("id")%>"><%=Web.e(br.get("name"))%></option><%}%></select></label></div><p class="micro">Existing copies are kept. Set the number above to add more copies.</p><button class="button" type="submit">Save book &#8594;</button></div></form></section>
<%@ include file="footer.jspf" %>
