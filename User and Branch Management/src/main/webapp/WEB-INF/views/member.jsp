<%@ page pageEncoding="UTF-8" %>
<%@ include file="header.jspf" %>
<section class="section"><%var m=(Map<String,Object>)request.getAttribute("member");%><h1><%=Web.e(m.get("name"))%></h1><p>Member #<%=m.get("id")%> · <%=Web.e(m.get("member_type"))%> · <%=DB.id(m,"active")==1?"Active":"Inactive"%></p><p><%=Web.e(m.get("email"))%> · <%=Web.e(m.get("phone"))%></p><%for(String attr:List.of("rows","fineRows")){var records=(List<Map<String,Object>>)request.getAttribute(attr);%><h2><%=attr.equals("rows")?"Borrowing history":"Fine history"%></h2><div class="table-wrap"><table><thead><tr><%if(!records.isEmpty())for(String k:records.get(0).keySet()){%><th><%=Web.e(k.replace('_',' '))%></th><%}%></tr></thead><tbody><%for(var row:records){%><tr><%for(var value:row.values()){%><td><%=value instanceof Timestamp?Web.date(value):Web.e(value)%></td><%}%></tr><%}%></tbody></table></div><%if(records.isEmpty()){%><p>No matching activity.</p><%}}%><a class="button" href="<%=ctx%>/circulation">Circulation</a></section>
<%@ include file="footer.jspf" %>